    return del.length;
}

async function __mfsHandleFiles(fileList, kind) {
    __mfs.status = 1; __mfs.message = "";
    try {
        var entries = [];
        var files = Array.prototype.slice.call(fileList);
        for (var i = 0; i < files.length; i++) {
            var f = files[i];
            if (kind === "zip" || /\.zip$/i.test(f.name)) {
                var z = await __mfsReadZip(f);
                entries = entries.concat(z);
            } else {
                (function (ff) { entries.push({ path: ff.webkitRelativePath || ff.name, get: async function () { return ff; } }); })(f);
            }
        }
        var names = await __mfsInstall(entries);
        __mfs.message = names.join(", ") + " (" + __mfs.report + ")";
        __mfs.status = 2;
    } catch (e) {
        __mfs.message = (e && e.message) ? e.message : "Install failed";
        __mfs.status = -1;
    }
}

function mod_fs_init() {
    if (!__mfs.started) { __mfs.started = true; __mfsLoadAll(); }
    return 1;
}

function mod_fs_ready() { mod_fs_init(); return __mfs.ready; }

function mod_fs_pick(kind) {
    try {
        mod_fs_init();
        var input = document.createElement("input");
        input.type = "file";
        if (kind === "folder") { input.webkitdirectory = true; input.multiple = true; }
        else { input.accept = ".zip,application/zip"; input.multiple = true; }
        input.style.display = "none";
        document.body.appendChild(input);
        __mfs.status = 1; __mfs.message = "";
        var done = false;
        input.addEventListener("change", function () {
            done = true;
            if (input.files && input.files.length) __mfsHandleFiles(input.files, kind).then(function () { input.remove(); });
            else { __mfs.status = -1; __mfs.message = "Cancelled"; input.remove(); }
        });
        input.addEventListener("cancel", function () { if (!done) { __mfs.status = -1; __mfs.message = "Cancelled"; input.remove(); } });
        input.click();
        return 1;
    } catch (e) { __mfs.status = -1; __mfs.message = "File picker unavailable"; return 0; }
}

function mod_fs_status() { return __mfs.status; }
function mod_fs_message() { return __mfs.message; }
function mod_fs_ack() { if (__mfs.status !== 1) __mfs.status = 0; return 1; }

function mod_fs_list(dir) {
    var d = String(dir).replace(/\\/g, "/").replace(/\/+$/, "");
    var ck = d.toLowerCase();
    var hit = __mfs.listCache.get(ck);
    if (hit && hit.ver === __mfs.ver) return hit.json;
    var pre = d === "" ? "" : d + "/";
    var seen = {};
    var out = [];
    var lowPre = pre.toLowerCase();
    __mfs.files.forEach(function (v, k) {
        if (k.toLowerCase().indexOf(lowPre) !== 0) return;
        var rest = k.substring(pre.length);
        var i = rest.indexOf("/");
        var name = i < 0 ? rest : rest.substring(0, i);
        var isDir = i >= 0 ? 1 : 0;
        var key = name + "|" + isDir;
        if (!seen[key]) { seen[key] = 1; out.push({ n: name, d: isDir }); }
    });
    var json = JSON.stringify(out);
    __mfs.listCache.set(ck, { ver: __mfs.ver, json: json });
    return json;
}

function __mfsFind(path) {
    var p = __mfsClean(path).join("/");
    if (__mfs.files.has(p)) return __mfs.files.get(p);
    return __mfs.low.get(p.toLowerCase()) || null;
}

function mod_fs_exists(path) { return __mfsFind(path) ? 1 : 0; }
function mod_fs_text(path) { var e = __mfsFind(path); return e ? e.text : ""; }
function mod_fs_url(path) {
    var e = __mfsFind(path);
    if (!e) return "";
    if (!e.url) e.url = URL.createObjectURL(e.blob);
    return e.url;
}
function mod_fs_remove(top) { return __mfsRemoveSync(__mfsClean(top).join("/")); }

// ---- synchronous image access for GML (decoded RGBA, base64) ----
function mod_fs_img_w(path) { var e = __mfsFind(path); return (e && e.rgba) ? e.w : 0; }
function mod_fs_img_h(path) { var e = __mfsFind(path); return (e && e.rgba) ? e.h : 0; }
function mod_fs_img_b64(path) {
    var e = __mfsFind(path);
    if (!e || !e.rgba) return "";
    var a = e.rgba, parts = [];
    for (var i = 0; i < a.length; i += 0x8000) parts.push(String.fromCharCode.apply(null, a.subarray(i, i + 0x8000)));
    return btoa(parts.join(""));
}

function mod_fs_aud_ch(path) { var e = __mfsFind(path); return (e && e.pcm) ? e.ach : 0; }
function mod_fs_aud_rate(path) { var e = __mfsFind(path); return (e && e.pcm) ? e.arate : 0; }
function mod_fs_aud_b64(path) {
    var e = __mfsFind(path);
    if (!e || !e.pcm) return "";
    var a = new Uint8Array(e.pcm.buffer), parts = [];
    for (var i = 0; i < a.length; i += 0x8000) parts.push(String.fromCharCode.apply(null, a.subarray(i, i + 0x8000)));
    return btoa(parts.join(""));
}

// ---- mods bundled with the game (zip files shipped as included files) ----
function mod_fs_bundled_install(url) {
    mod_fs_init();
    __mfs.status = 1; __mfs.message = "";
    (async function () {
        try {
            var bases = [String(url), "./" + String(url).replace(/^[.\/]+/, ""), "/" + String(url).replace(/^[.\/]+/, "")];
            var blob = null;
            for (var i = 0; i < bases.length && !blob; i++) {
                try {
                    var r = await fetch(bases[i]);
                    if (r.ok) blob = await r.blob();
                } catch (x) {}
            }
            if (!blob) throw new Error("Bundled mod file not found");
            var z = await __mfsReadZip(blob);
            var names = await __mfsInstall(z);
            __mfs.message = names.join(", ") + " (" + __mfs.report + ")";
            __mfs.status = 2;
        } catch (e) {
            __mfs.message = (e && e.message) ? e.message : "Install failed";
            __mfs.status = -1;
        }
    })();
    return 1;
}


// ---- save backup export / import (browser download + file picker) ----
var __fbImp = { status: 0, content: "" };
function fb_file_export(name, content) {
    var blob = new Blob([String(content)], { type: "application/json" });
    var a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = String(name);
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    setTimeout(function () { URL.revokeObjectURL(a.href); }, 5000);
    return 1;
}
function fb_file_import_start() {
    __fbImp.status = 0; __fbImp.content = "";
    var input = document.createElement("input");
    input.type = "file"; input.accept = ".json,application/json,text/plain";
    input.onchange = function (e) {
        var f = e.target.files && e.target.files[0];
        if (!f) { __fbImp.status = -1; return; }
        var r = new FileReader();
        r.onload = function (ev) { __fbImp.content = String(ev.target.result); __fbImp.status = 1; };
        r.onerror = function () { __fbImp.status = -1; };
        r.readAsText(f, "UTF-8");
    };
    input.addEventListener("cancel", function () { if (__fbImp.status === 0) __fbImp.status = -1; });
    input.click();
    return 1;
}
function fb_file_import_status() { return __fbImp.status; }
function fb_file_import_content() { return __fbImp.content; }
