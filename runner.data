}

// ---- zip reading (stored + deflate, via DecompressionStream) ----
async function __mfsInflate(bytes) {
    var ds = new DecompressionStream("deflate-raw");
    var w = ds.writable.getWriter();
    w.write(bytes); w.close();
    return new Uint8Array(await new Response(ds.readable).arrayBuffer());
}

async function __mfsReadZip(file) {
    var buf = new Uint8Array(await file.arrayBuffer());
    var dv = new DataView(buf.buffer);
    var eocd = -1;
    for (var i = buf.length - 22; i >= Math.max(0, buf.length - 65557); i--) {
        if (dv.getUint32(i, true) === 0x06054b50) { eocd = i; break; }
    }
    if (eocd < 0) throw new Error("Not a valid zip file");
    var count = dv.getUint16(eocd + 10, true);
    var pos = dv.getUint32(eocd + 16, true);
    var out = [];
    var dec = new TextDecoder("utf-8");
    for (var n = 0; n < count; n++) {
        if (dv.getUint32(pos, true) !== 0x02014b50) break;
        var flags = dv.getUint16(pos + 8, true);
        var method = dv.getUint16(pos + 10, true);
        var csize = dv.getUint32(pos + 20, true);
        var usize = dv.getUint32(pos + 24, true);
        var nlen = dv.getUint16(pos + 28, true);
        var elen = dv.getUint16(pos + 30, true);
        var clen = dv.getUint16(pos + 32, true);
        var loff = dv.getUint32(pos + 42, true);
        var name = dec.decode(buf.subarray(pos + 46, pos + 46 + nlen));
        pos += 46 + nlen + elen + clen;
        if (name.endsWith("/")) continue;
        if (usize > __MFS_MAX_FILE) continue;
        var lnlen = dv.getUint16(loff + 26, true);
        var lelen = dv.getUint16(loff + 28, true);
        var start = loff + 30 + lnlen + lelen;
        var raw = buf.subarray(start, start + csize);
        (function (nm, md, rw) {
            out.push({ path: nm, get: async function () {
                if (md === 0) return new Blob([rw]);
                if (md === 8) return new Blob([await __mfsInflate(rw)]);
                throw new Error("Unsupported zip compression");
            } });
        })(name, method, raw);
    }
    return out;
}

// ---- decide where files go ----
function __mfsClean(p) {
    var parts = String(p).replace(/\\/g, "/").split("/").filter(function (s) { return s !== "" && s !== "." && s !== ".."; });
    return parts;
}

function __mfsPlan(entries) {
    // returns [{ src: entry, dest: "addons/Name/rel" }]
    var plan = [];
    var all = entries.map(function (e) { return { e: e, parts: __mfsClean(e.path) }; })
        .filter(function (x) { return x.parts.length > 0 && x.parts[0] !== "__MACOSX" && !/\.win$/i.test(x.parts[x.parts.length - 1]); });
    var low = function (s) { return s.toLowerCase(); };
    // 1) archive already has addons/ or skins/ at depth 0 or 1
    var rooted = false;
    all.forEach(function (x) {
        for (var d = 0; d <= 1 && d < x.parts.length - 1; d++) {
            var s = low(x.parts[d]);
            if (s === "addons" || s === "skins") {
                plan.push({ src: x.e, dest: s + "/" + x.parts.slice(d + 1).join("/") });
                rooted = true;
                return;
            }
        }
    });
    if (rooted) return plan;
    // 2) find guard roots: folders holding extras_info.txt (addon) or data.txt + sprites/ (skin)
    var roots = {};
    all.forEach(function (x) {
        var f = low(x.parts[x.parts.length - 1]);
        if (f === "extras_info.txt" && x.parts.length >= 2) roots[x.parts.slice(0, -1).join("/")] = "addons";
    });
    all.forEach(function (x) {
        var f = low(x.parts[x.parts.length - 1]);
        if (f === "data.txt" && x.parts.length >= 2) {
            var dir = x.parts.slice(0, -1).join("/");
            if (!roots[dir] && all.some(function (y) { return y.parts.join("/").toLowerCase().indexOf(dir.toLowerCase() + "/sprites/") === 0; })) roots[dir] = "skins";
        }
    });
    Object.keys(roots).forEach(function (dir) {
        var dparts = dir.split("/");
        var name = dparts[dparts.length - 1];
        all.forEach(function (x) {
            var j = x.parts.join("/");
            if (j.indexOf(dir + "/") === 0) plan.push({ src: x.e, dest: roots[dir] + "/" + name + "/" + j.substring(dir.length + 1) });
        });
    });
    // 3) a single loose guard folder given as zip contents without extras_info.txt is rejected
    return plan;
}

async function __mfsInstall(entries) {
    var plan = __mfsPlan(entries);
    if (plan.length === 0) throw new Error("No guard found (needs extras_info.txt)");
    // remove old copies of the same guards
    var tops = {};
    plan.forEach(function (p) { var s = p.dest.split("/"); tops[s[0] + "/" + s[1]] = 1; });
    Object.keys(tops).forEach(function (t) { __mfsRemoveSync(t); });
    var names = Object.keys(tops).map(function (t) { return t.split("/")[1]; });
    var written = [];
