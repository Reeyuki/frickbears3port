// Audio is tapped by wrapping AudioNode.connect so anything routed to the speakers is also routed to a recorder stream.
var __trec = { rec: null, chunks: [], dests: [], started: false };

(function () {
    try {
        var origConnect = AudioNode.prototype.connect;
        AudioNode.prototype.connect = function (dest) {
            var r = origConnect.apply(this, arguments);
            try {
                if (dest && typeof AudioDestinationNode !== "undefined" && dest instanceof AudioDestinationNode) {
                    var ctx = dest.context;
                    if (!ctx.__trecDest) {
                        ctx.__trecDest = ctx.createMediaStreamDestination();
                        __trec.dests.push(ctx.__trecDest);
                    }
                    if (!this.__trecTapped) {
                        origConnect.call(this, ctx.__trecDest);
                        this.__trecTapped = true;
                    }
                }
            } catch (e) {}
            return r;
        };
    } catch (e) {}
})();

function trailer_rec_start() {
    try {
        if (__trec.rec) return 0;
        var canvas = document.getElementById("canvas") || document.querySelector("canvas");
        if (!canvas || !canvas.captureStream) return 0;
        var tracks = canvas.captureStream(30).getVideoTracks();
        var hasAudio = false;
        for (var i = 0; i < __trec.dests.length; i++) {
            var at = __trec.dests[i].stream.getAudioTracks();
            for (var j = 0; j < at.length; j++) { tracks.push(at[j]); hasAudio = true; }
        }
        var stream = new MediaStream(tracks);
        var mime = "video/webm;codecs=vp9,opus";
        if (!MediaRecorder.isTypeSupported(mime)) mime = "video/webm;codecs=vp8,opus";
        if (!MediaRecorder.isTypeSupported(mime)) mime = "video/webm";
        __trec.chunks = [];
        __trec.rec = new MediaRecorder(stream, { mimeType: mime, videoBitsPerSecond: 8000000 });
        __trec.rec.ondataavailable = function (e) { if (e.data && e.data.size) __trec.chunks.push(e.data); };
        __trec.rec.onstop = function () {
            var blob = new Blob(__trec.chunks, { type: "video/webm" });
            var a = document.createElement("a");
            a.href = URL.createObjectURL(blob);
            a.download = "frickbears3_trailer.webm";
            document.body.appendChild(a);
            a.click();
            setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 4000);
            __trec.rec = null;
        };
        __trec.rec.onerror = function (e) { console.log("trailer rec error", e); };
        __trec.rec.addEventListener("stop", function () { console.log("trailer rec stopped, chunks=" + __trec.chunks.length); });
        __trec.rec.start(500);
        return hasAudio ? 2 : 1; // 2 = video+audio, 1 = video only
    } catch (e) { return 0; }
}

function trailer_rec_stop() {
    try { if (__trec.rec && __trec.rec.state !== "inactive") { __trec.rec.stop(); return 1; } } catch (e) {}
    return 0;
}

// Download everything recorded so far (works while recording and after it ended), without stopping the recorder.
function trailer_rec_save() {
    try {
        if (!__trec.chunks.length) return 0;
        var blob = new Blob(__trec.chunks, { type: "video/webm" });
        var a = document.createElement("a");
        a.href = URL.createObjectURL(blob);
        a.download = "frickbears3_trailer_export.webm";
        document.body.appendChild(a);
        a.click();
        setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 4000);
        return 1;
    } catch (e) { return 0; }
}
// mod_fs: browser-side virtual file system for custom-guard mods.
// Mods (a .zip or a folder) are unpacked into IndexedDB and mirrored in memory so GML can read them synchronously.
// Paths are like "addons/Vee/icon.png". Binary files are served to GML as blob: URLs (for sprite_add / audio_create_stream).
var __mfs = {
    files: new Map(),   // path -> { blob, url, text }
    low: new Map(),     // lowercase path -> entry (O(1) case-insensitive lookup)
    ver: 0,             // bumped on every change; invalidates listing caches
    listCache: new Map(),
    ready: 0,
    status: 0,          // 0 idle, 1 busy, 2 done, -1 failed/cancelled
    message: "",
    db: null
};
var __MFS_MAX_FILE = 64 * 1024 * 1024;

function __mfsOpenDb() {
    return new Promise(function (res, rej) {
        var rq = indexedDB.open("fb3_mod_fs", 1);
        rq.onupgradeneeded = function () { rq.result.createObjectStore("files", { keyPath: "p" }); };
        rq.onsuccess = function () { res(rq.result); };
        rq.onerror = function () { rej(rq.error); };
    });
}

function __mfsTidyJson(t) {
    if (t.charCodeAt(0) === 0xFEFF) t = t.substring(1);
    var out = "", inStr = false, esc = false;
    for (var i = 0; i < t.length; i++) {
        var c = t[i];
        if (inStr) { out += c; if (esc) esc = false; else if (c === "\\") esc = true; else if (c === '"') inStr = false; continue; }
        if (c === '"') { inStr = true; out += c; continue; }
        if (c === "," ) {
            var j = i + 1;
            while (j < t.length && /\s/.test(t[j])) j++;
            if (t[j] === "]" || t[j] === "}") continue;
        }
        out += c;
    }
    return out;
}

function __mfsIsText(p) { return /\.(txt|json|ini|cfg|csv)$/i.test(p); }

async function __mfsDecode(e) {
    // decode a png to raw RGBA now, so GML can build a sprite synchronously (sprite_add from a URL is asynchronous on web)
    try {
        var bmp = await createImageBitmap(e.blob);
        var c = document.createElement("canvas");
        c.width = bmp.width; c.height = bmp.height;
        var cx = c.getContext("2d", { willReadFrequently: true });
        cx.drawImage(bmp, 0, 0);
        e.rgba = cx.getImageData(0, 0, c.width, c.height).data;
        e.w = c.width; e.h = c.height;
        if (bmp.close) bmp.close();
    } catch (x) { e.w = 0; e.h = 0; e.rgba = null; try { console.log("[mod_fs] image decode failed", x); } catch (y) {} }
}

async function __mfsDecodeAudio(e) {
    // GameMaker's audio_create_stream cannot open blob: URLs on web, so decode to 16-bit PCM for audio_create_buffer_sound
    try {
        if (e.blob.size > 3 * 1024 * 1024) return;
        var ctx = new OfflineAudioContext(1, 1, 44100);
        var ab = await ctx.decodeAudioData(await e.blob.arrayBuffer());
        var ch = Math.min(2, ab.numberOfChannels), n = ab.length, pcm = new Int16Array(n * ch);
        for (var c = 0; c < ch; c++) {
            var d = ab.getChannelData(c);
            for (var i = 0; i < n; i++) { var v = Math.max(-1, Math.min(1, d[i])); pcm[i * ch + c] = v < 0 ? v * 32768 : v * 32767; }
        }
        e.pcm = pcm; e.ach = ch; e.arate = ab.sampleRate;
    } catch (x) { e.pcm = null; try { console.log("[mod_fs] audio decode failed", x); } catch (y) {} }
}

async function __mfsAdd(p, blob) {
    var e = { blob: blob, url: "", text: "", w: 0, h: 0, rgba: null, pcm: null, ach: 0, arate: 0 };
    if (/\.png$/i.test(p)) await __mfsDecode(e);
    if (/\.(ogg|mp3|wav)$/i.test(p)) await __mfsDecodeAudio(e);
    if (__mfsIsText(p)) { try { e.text = __mfsTidyJson(await blob.text()); } catch (x) { e.text = ""; } }
    __mfs.files.set(p, e);
    __mfs.low.set(p.toLowerCase(), e);
    __mfs.ver++;
}

async function __mfsLoadAll() {
    try {
        __mfs.db = await __mfsOpenDb();
        await new Promise(function (res) {
            var tx = __mfs.db.transaction("files", "readonly");
            var rq = tx.objectStore("files").getAll();
            rq.onsuccess = async function () {
                for (var i = 0; i < rq.result.length; i++) await __mfsAdd(rq.result[i].p, rq.result[i].blob);
